+local function _logcat(tag, msg)
+    if _RELEASE_MODE then return end
+    tag = tag or "BALATRO"
+    msg = tostring(msg or "")
+    print(tag .. ": " .. msg)
+    if love and love.system and love.system.getOS and love.system.getOS() == 'Android' then
+        pcall(function()
+            local p = io.popen('log -t "'..tag..'" "'..msg:gsub('"', '\\"')..'"', 'w')
+            if p then p:close() end
+        end)
+    end
+end
+
+local function _normalize_touch_coords(x, y, dx, dy)
+    local tx, ty, tdx, tdy = x, y, dx, dy
+    if type(tx) == 'number' and type(ty) == 'number' and tx >= 0 and tx <= 1 and ty >= 0 and ty <= 1 then
+        local w, h = love.graphics.getDimensions()
+        tx, ty = tx * w, ty * h
+        if type(tdx) == 'number' then tdx = tdx * w end
+        if type(tdy) == 'number' then tdy = tdy * h end
+    end
+    return tx, ty, tdx, tdy
+end
+
+local function _transform_rotated_input(x, y, dx, dy)
+    if not (G and G.F_ROTATED_LANDSCAPE) then return x, y, dx, dy end
+    local screen_w = G.PORTRAIT_SCREEN_W or love.graphics.getWidth()
+    -- mousepressed/mousereleased carry only x/y/button/touch. Their deltas are
+    -- nil; rotate the deltas only for mousemoved, where dx/dy are numeric.
+    local rotated_dx = type(dy) == 'number' and dy or nil
+    local rotated_dy = type(dx) == 'number' and -dx or nil
+    return y, screen_w - x, rotated_dx, rotated_dy
+end
